# Optional. Without it the app is desktop-only in practice: `injected` finds a wallet only if one
# has injected itself into the page, which on a phone means the visitor is already inside a
# wallet's own browser. Free id from https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional. Shown to wallets during a WalletConnect handshake; defaults to the production URL.
NEXT_PUBLIC_SITE_URL=

# Optional overrides. Both default to the mainnet deployment in src/lib/deployments.ts.
# Set the chain id to 5042002 to run the app against Arc testnet.
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_ARC_RPC_URL=
