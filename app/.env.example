# Which Arc network to target: 5042 (mainnet) or 5042002 (testnet).
# Must match the network the factory below is deployed on.
NEXT_PUBLIC_CHAIN_ID=5042

# Arc RPC. Defaults to the public mainnet endpoint when unset.
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.mainnet.arc.io

# VaultFactory address, printed by contracts/script/Deploy.s.sol.
# Until this is set the dashboard renders its "not deployed" state instead of reading address zero.
NEXT_PUBLIC_FACTORY_ADDRESS=

# Live Arc testnet deployment (chain 5042002):
#   NEXT_PUBLIC_CHAIN_ID=5042002
#   NEXT_PUBLIC_FACTORY_ADDRESS=0x28e745eBf4b8E8b758c7B4a11b2e453322cDC3CA
